---
import { SITE } from "@config/site";
import type { Story } from "@data/stories";
import { useTranslations, type Lang } from "@i18n/utils";

/**
 * Tarjeta 9:16 (1080×1920) lista para subir como historia de Instagram.
 * Reutiliza el lenguaje visual del sitio (negro/dorado, Anton + Cormorant)
 * y lleva la URL de la web para quien la vea en redes. Se renderiza en una
 * ruta dedicada y se captura como imagen estática (ver /share/[slug]).
 */
interface Props {
  story: Story;
  lang: Lang;
}
const { story, lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="relative flex h-[1920px] w-[1080px] flex-col overflow-hidden bg-fenix-black">
  <!-- Foto del jugador a pantalla completa -->
  <img
    src={story.image}
    alt={story.name}
    class="absolute inset-0 h-full w-full object-cover object-top"
  />

  <!-- Scrims para legibilidad -->
  <div class="absolute inset-0 bg-gradient-to-t from-fenix-black via-fenix-black/30 to-fenix-black/25"></div>
  <div class="absolute inset-x-0 top-0 h-[420px] bg-gradient-to-b from-fenix-black/85 to-transparent"></div>

  <!-- Resplandor dorado -->
  <div
    class="pointer-events-none absolute -bottom-40 left-1/2 h-[900px] w-[900px] -translate-x-1/2 rounded-full bg-fenix-gold/15 blur-[220px]"
  >
  </div>

  <!-- Marca de agua: dorsal gigante -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -right-16 top-[24%] font-display text-[34rem] leading-none text-fenix-white/[0.06]"
  >
    {story.number}
  </span>

  <!-- Contenido -->
  <div class="relative z-10 flex h-full flex-col justify-between p-24">
    <!-- Cabecera de marca -->
    <div class="flex items-center gap-5">
      <svg viewBox="0 0 24 24" fill="none" class="h-16 w-16" aria-hidden="true">
        <path
          d="M12 2c1.5 3.5-1 5.5-2 7.5-1.2 2.4-.4 4.6 2 4.6 2 0 3-1.6 2.6-3.6 1.8 1.4 2.9 3.6 2.9 6C17.5 20 15 22 12 22s-6-2.3-6-6.2C6 10 10.5 7.5 12 2Z"
          fill="#D4AF37"
        ></path>
      </svg>
      <span class="font-display text-5xl uppercase tracking-[0.25em] text-fenix-ivory">
        Proyecto <span class="text-fenix-gold">Fénix</span>
      </span>
    </div>

    <!-- Identidad + cita + URL -->
    <div>
      <div class="flex flex-wrap items-center gap-4">
        <span
          class="inline-flex items-center gap-3 rounded-full border border-fenix-gold/40 bg-fenix-black/50 px-7 py-3 text-3xl font-semibold tracking-widest text-fenix-ivory backdrop-blur-md"
        >
          <span class="text-4xl leading-none">{story.flag}</span>
          {story.country}
        </span>
        <span
          class="inline-flex items-center rounded-full bg-fenix-gold/15 px-7 py-3 text-2xl font-semibold uppercase tracking-[0.2em] text-fenix-gold ring-1 ring-inset ring-fenix-gold/40"
        >
          #{story.number} · {story.position[lang]}
        </span>
        <span class="text-2xl uppercase tracking-[0.25em] text-fenix-ivory/70">
          {story.origin[lang]} · {story.age}
        </span>
      </div>

      <h1
        class="mt-10 font-display text-[10rem] uppercase leading-[0.82] tracking-wide text-fenix-white drop-shadow-[0_6px_30px_rgba(0,0,0,0.7)]"
      >
        {story.name}
      </h1>

      <p class="mt-10 max-w-[860px] font-serif text-6xl italic leading-[1.15] text-fenix-ivory/90">
        “{story.hook[lang]}”
      </p>

      <!-- Llamado a la web -->
      <div class="mt-16 flex items-center justify-between border-t border-fenix-gold/30 pt-10">
        <span class="text-3xl uppercase tracking-[0.2em] text-fenix-ivory/70">
          {t("story.share.readmore")}
        </span>
        <span class="font-display text-5xl uppercase tracking-wider text-fenix-gold">
          {SITE.domain}
        </span>
      </div>
    </div>
  </div>
</div>
