---
import Container from "@components/ui/Container.astro";
import Logo from "@components/navbar/Logo.astro";
import NavLinks from "@components/navbar/NavLinks.astro";
import LanguageSwitcher from "@components/navbar/LanguageSwitcher.astro";
import SocialLinks from "./SocialLinks.astro";
import { SITE } from "@config/site";
import { useTranslations, type Lang } from "@i18n/utils";

/** Pie de página: marca, navegación, redes, idioma y copyright. */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-fenix-ivory/10 bg-fenix-black">
  <Container class="py-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Marca -->
      <div class="flex flex-col gap-5 lg:col-span-5">
        <Logo lang={lang} />
        <p class="max-w-xs font-serif text-xl italic leading-snug text-fenix-ivory/70">
          {t("footer.tagline")}
        </p>
      </div>

      <!-- Navegación -->
      <div class="lg:col-span-3">
        <h3 class="text-xs uppercase tracking-[0.3em] text-fenix-gold">{t("footer.nav")}</h3>
        <NavLinks lang={lang} class="mt-5 flex flex-col gap-3" />
      </div>

      <!-- Redes -->
      <div class="lg:col-span-2">
        <h3 class="text-xs uppercase tracking-[0.3em] text-fenix-gold">{t("footer.social")}</h3>
        <SocialLinks class="mt-5 flex-col" />
      </div>

      <!-- Idioma -->
      <div class="lg:col-span-2">
        <h3 class="text-xs uppercase tracking-[0.3em] text-fenix-gold">{t("footer.lang")}</h3>
        <LanguageSwitcher lang={lang} class="mt-5 text-sm" />
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-4 border-t border-fenix-ivory/10 pt-8 text-xs text-fenix-ivory/40 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.name}. {t("footer.rights")}</p>
      <p>{SITE.email}</p>
    </div>
  </Container>
</footer>
