---
/** Contenedor centrado con ancho máximo y padding lateral consistente. */
interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}
const { as: Tag = "div", class: className = "" } = Astro.props;
---

<Tag class:list={["mx-auto w-full max-w-7xl px-6 sm:px-8 lg:px-12", className]}>
  <slot />
</Tag>
