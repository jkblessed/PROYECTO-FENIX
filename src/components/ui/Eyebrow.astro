---
/** Etiqueta superior (kicker) en oro, con línea decorativa. */
interface Props {
  text: string;
  class?: string;
}
const { text, class: className = "" } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-3 text-xs font-medium uppercase tracking-[0.35em] text-fenix-gold",
    className,
  ]}
>
  <span class="h-px w-8 bg-fenix-gold/60"></span>
  {text}
</span>
