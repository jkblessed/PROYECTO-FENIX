---
import Navbar from "@components/navbar/Navbar.astro";
import Hero from "@components/hero/Hero.astro";
import Mission from "@components/mission/Mission.astro";
import Marquee from "@components/marquee/Marquee.astro";
import Stories from "@components/stories/Stories.astro";
import CallToAction from "@components/cta/CallToAction.astro";
import Footer from "@components/footer/Footer.astro";
import RevealObserver from "@components/effects/RevealObserver.astro";
import TiltCards from "@components/effects/TiltCards.astro";
import type { Lang } from "@i18n/utils";

/**
 * Composición de secciones del Landing V1.
 * Punto único de ensamblado: las páginas por idioma solo pasan `lang`.
 */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Navbar lang={lang} />
<main>
  <Hero lang={lang} />
  <Mission lang={lang} />
  <Marquee lang={lang} />
  <Stories lang={lang} />
  <CallToAction lang={lang} />
</main>
<Footer lang={lang} />

<RevealObserver />
<TiltCards />
