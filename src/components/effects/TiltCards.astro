---
/**
 * Activa el tilt 3D + brillo que sigue al cursor en todo [data-tilt].
 * Actualiza las variables CSS --rx/--ry (rotación) y --mx/--my (posición del
 * brillo). Se incluye una vez por página y respeta prefers-reduced-motion.
 */
---

<script>
  const MAX_TILT = 7; // grados

  function bindTilt(card: HTMLElement) {
    if (card.dataset.tiltBound) return;
    card.dataset.tiltBound = "true";

    let frame = 0;

    const onMove = (e: PointerEvent) => {
      const rect = card.getBoundingClientRect();
      const px = (e.clientX - rect.left) / rect.width; // 0..1
      const py = (e.clientY - rect.top) / rect.height; // 0..1

      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        card.style.setProperty("--ry", `${(px - 0.5) * 2 * MAX_TILT}deg`);
        card.style.setProperty("--rx", `${(0.5 - py) * 2 * MAX_TILT}deg`);
        card.style.setProperty("--mx", `${px * 100}%`);
        card.style.setProperty("--my", `${py * 100}%`);
      });
    };

    const onEnter = () => card.classList.add("is-tilting");
    const onLeave = () => {
      cancelAnimationFrame(frame);
      card.classList.remove("is-tilting");
      card.style.setProperty("--rx", "0deg");
      card.style.setProperty("--ry", "0deg");
    };

    card.addEventListener("pointerenter", onEnter);
    card.addEventListener("pointermove", onMove);
    card.addEventListener("pointerleave", onLeave);
  }

  function initTilt() {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const coarse = window.matchMedia("(pointer: coarse)").matches;
    if (reduce || coarse) return; // sin tilt en táctil o con motion reducido
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach(bindTilt);
  }

  initTilt();
  document.addEventListener("astro:page-load", initTilt);
</script>
