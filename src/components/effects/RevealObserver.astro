---
/**
 * Observer global para los elementos [data-reveal].
 * Se incluye una sola vez por página. Compatible con View Transitions:
 * se re-inicializa en `astro:page-load`.
 */
---

<script>
  function initReveal() {
    const elements = document.querySelectorAll<HTMLElement>("[data-reveal]:not(.is-visible)");
    if (!elements.length) return;

    if (!("IntersectionObserver" in window)) {
      elements.forEach((el) => el.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
    );

    elements.forEach((el) => observer.observe(el));
  }

  // Solo `astro:page-load` (con ClientRouter dispara también en la carga inicial).
  // Evita crear dos IntersectionObserver sobre los mismos elementos.
  document.addEventListener("astro:page-load", initReveal);
</script>
