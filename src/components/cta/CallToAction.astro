---
import Section from "@components/ui/Section.astro";
import Eyebrow from "@components/ui/Eyebrow.astro";
import Button from "@components/ui/Button.astro";
import Reveal from "@components/effects/Reveal.astro";
import { useTranslations, type Lang } from "@i18n/utils";

/**
 * Llamado a la acción final ("Únete"). Captura de correo (placeholder,
 * sin backend en V1) con copy emocional. id="join" para la navegación.
 */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="join" class="relative overflow-hidden bg-fenix-black">
  <!-- Resplandor dorado de fondo -->
  <div
    class="pointer-events-none absolute left-1/2 top-1/2 -z-0 h-[36rem] w-[36rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-fenix-gold/10 blur-[140px]"
  >
  </div>

  <div class="relative mx-auto max-w-3xl text-center">
    <Reveal>
      <Eyebrow text={t("cta.eyebrow")} class="justify-center" />
    </Reveal>
    <Reveal delay={100}>
      <h2
        class="mt-8 font-display text-4xl uppercase leading-[1.02] tracking-tight text-fenix-white sm:text-6xl"
      >
        {t("cta.title")}
      </h2>
    </Reveal>
    <Reveal delay={150}>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-fenix-ivory/70">
        {t("cta.body")}
      </p>
    </Reveal>

    <Reveal delay={250}>
      <form
        class="mx-auto mt-10 flex max-w-md flex-col gap-3 sm:flex-row"
        onsubmit="return false"
      >
        <label for="cta-email" class="sr-only">{t("cta.placeholder")}</label>
        <input
          id="cta-email"
          type="email"
          name="email"
          required
          placeholder={t("cta.placeholder")}
          class="w-full rounded-full border border-fenix-ivory/15 bg-fenix-gray/60 px-6 py-3.5 text-sm text-fenix-ivory placeholder:text-fenix-ivory/40 focus:border-fenix-gold/60 focus:outline-none focus:ring-2 focus:ring-fenix-gold/30"
        />
        <Button type="submit" variant="gold" class="shrink-0">{t("cta.button")}</Button>
      </form>
    </Reveal>
  </div>
</Section>
