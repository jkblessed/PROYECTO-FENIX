---
import { MAIN_NAV } from "@config/navigation";
import { useTranslations, localizePath, type Lang } from "@i18n/utils";

/** Lista de enlaces de navegación on-page, derivada de la config. */
interface Props {
  lang: Lang;
  class?: string;
  linkClass?: string;
}
const { lang, class: className = "", linkClass = "" } = Astro.props;
const t = useTranslations(lang);
// Anclas apuntadas a la home localizada + hash, para que también funcionen
// desde las páginas de historia (donde esas secciones no existen).
const home = localizePath("/", lang);
---

<ul class:list={[className]}>
  {
    MAIN_NAV.map((link) => (
      <li>
        <a
          href={`${home}${link.anchor}`}
          class:list={[
            "relative text-sm tracking-wide text-fenix-ivory/75 transition-colors duration-300 hover:text-fenix-ivory",
            "after:absolute after:-bottom-1.5 after:left-0 after:h-px after:w-0 after:bg-fenix-gold after:transition-all after:duration-300 hover:after:w-full",
            linkClass,
          ]}
        >
          {t(link.labelKey)}
        </a>
      </li>
    ))
  }
</ul>
