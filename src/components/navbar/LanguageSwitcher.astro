---
import { languages } from "@i18n/ui";
import { type Lang } from "@i18n/utils";
import { alternateLangPath } from "@data/stories";

/**
 * Selector de idioma. Enlaza a la versión equivalente de la PÁGINA actual en
 * cada locale (home ↔ home, historia ↔ historia), sin perder el contexto.
 */
interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: className = "" } = Astro.props;
const codes = Object.keys(languages) as Lang[];
const current = Astro.url.pathname;
---

<div class:list={["flex items-center gap-1 text-xs font-medium tracking-wider", className]}>
  {
    codes.map((code, i) => (
      <>
        {i > 0 && <span class="text-fenix-ivory/25">/</span>}
        <a
          href={alternateLangPath(current, code)}
          hreflang={code}
          aria-current={code === lang ? "true" : undefined}
          class:list={[
            "uppercase transition-colors duration-300",
            code === lang ? "text-fenix-gold" : "text-fenix-ivory/50 hover:text-fenix-ivory",
          ]}
        >
          {code}
        </a>
      </>
    ))
  }
</div>
